# Configuração usada pelos testes de integração (ver src/tests/setup.ts).
# Copie para .env.test. Aponta para um banco SEPARADO do de desenvolvimento
# — os testes apagam todas as linhas de todas as tabelas entre cada caso
# (cleanDatabase(), em src/tests/helpers.ts), então rodar contra o mesmo
# banco do `npm run dev` destruiria dado real que você criou testando manualmente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_desk_test"
JWT_SECRET="segredo-de-teste-nao-usar-em-producao"
PORT=3334
