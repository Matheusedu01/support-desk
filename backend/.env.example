# Copie este arquivo para .env e ajuste os valores.

# String de conexão do PostgreSQL. Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_desk"

# Chave usada para assinar os tokens JWT. Em produção, use um valor longo e aleatório
# (ex: gerado com `openssl rand -base64 32`) e NUNCA versione o valor real.
JWT_SECRET="troque-isto-por-um-segredo-forte"

# Porta em que a API vai escutar
PORT=3333
